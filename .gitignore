# Build outputs (Switch / CMake / Meson / Make)
build/
dist/
out/
*.nro
*.elf
*.nacp
*.nso
*.nsp
*.o
*.d
*.a
*.so

# Upstream core checkouts (fetched via scripts/bootstrap-cores.sh, locked by third_party/upstreams.lock.json)
third_party/EasyRPG-Player/
third_party/nx.js/
third_party/mkxp-z/

# Node / TypeScript / pnpm (nx.js & MV/MZ shim)
node_modules/
.pnpm-store/
.turbo/
*.tsbuildinfo
cores/nxjs-mvz/romfs/
cores/nxjs-mvz/icon.jpg
cores/nxjs-mvz/*.nro

# Local runtime / test game dumps (never commit user games, RTPs, caches, or saves)
sdcard/switch/nx.rpg/games/*
!sdcard/switch/nx.rpg/games/.gitkeep
sdcard/switch/nx.rpg/saves/*
!sdcard/switch/nx.rpg/saves/.gitkeep
sdcard/switch/nx.rpg/rtp/*/*
!sdcard/switch/nx.rpg/rtp/*/.gitkeep
sdcard/switch/nx.rpg/fonts/*
!sdcard/switch/nx.rpg/fonts/.gitkeep
sdcard/switch/nx.rpg/cores/*
!sdcard/switch/nx.rpg/cores/.gitkeep
sdcard/switch/nx.rpg/cache/*
!sdcard/switch/nx.rpg/cache/.gitkeep
!sdcard/switch/nx.rpg/cache/covers
sdcard/switch/nx.rpg/cache/covers/*
!sdcard/switch/nx.rpg/cache/covers/.gitkeep
sdcard/switch/nx.rpg/runtime/*
!sdcard/switch/nx.rpg/runtime/.gitkeep
sdcard/switch/nx.rpg/logs/*
!sdcard/switch/nx.rpg/logs/.gitkeep
sdcard/switch/nx.rpg/logs/games/*
!sdcard/switch/nx.rpg/logs/games/.gitkeep

# Python cache
__pycache__/
*.pyc

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
tests/build-host/
