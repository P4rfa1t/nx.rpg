{
  "schemaVersion": 1,
  "uiLanguage": "zh-CN",
  "defaultEncoding": "auto",
  "fallbackFontPath": "sdmc:/switch/nx.rpg/fonts/NotoSansCJK-Regular.ttc",
  "warnOnAppletMode": true,
  "performance": {
    "defaultCpuProfile": "system_default"
  },
  "video": {
    "scalingMode": "fit",
    "integerScale": false,
    "vsync": true,
    "showFps": false
  },
  "input": {
    "profile": "default",
    "swapConfirmCancel": false,
    "enableTouch": true,
    "exitCombo": ["L", "R", "PLUS"]
  },
  "library": {
    "maxScanDepth": 2,
    "sortOrder": "recent",
    "lastSelectedGameId": ""
  }
}
