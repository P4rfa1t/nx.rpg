+void nx_env_set_next_load(const FunctionCallbackInfo<Value> &info) {
+	Isolate *iso = info.GetIsolate();
+	if (info.Length() < 1 || !info[0]->IsString()) {
+		nx_throw(iso, "setNextLoad(path, argv?) requires a string path");
+		return;
+	}
+	if (!envHasNextLoad()) {
+		nx_throw(iso, "envHasNextLoad() is false in current environment");
+		return;
+	}
+	String::Utf8Value path_utf8(iso, info[0]);
+	const char *path = *path_utf8 ? *path_utf8 : "";
+	if (info.Length() >= 2 && info[1]->IsString()) {
+		String::Utf8Value argv_utf8(iso, info[1]);
+		const char *argv = *argv_utf8 ? *argv_utf8 : path;
+		Result rc = envSetNextLoad(path, argv);
+		if (R_FAILED(rc)) {
+			nx_throw_libnx_error(iso, rc, "envSetNextLoad");
+		}
+		return;
+	}
+	Result rc = envSetNextLoad(path, path);
+	if (R_FAILED(rc)) {
+		nx_throw_libnx_error(iso, rc, "envSetNextLoad");
+	}
+}
