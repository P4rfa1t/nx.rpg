new file mode 100644
index 0000000..b39dfb3
--- /dev/null
+++ b/src/switch_stubs.c
@@ -0,0 +1,63 @@
+#ifdef __SWITCH__
+
+#include <errno.h>
+#include <stdio.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+struct passwd;
+
+struct rusage_stub {
+    long ru_utime_sec;
+    long ru_utime_usec;
+    long ru_stime_sec;
+    long ru_stime_usec;
+    long pad[14];
+};
+
+__attribute__((weak)) uid_t getuid(void) { return 0; }
+__attribute__((weak)) uid_t geteuid(void) { return 0; }
+__attribute__((weak)) gid_t getgid(void) { return 0; }
+__attribute__((weak)) gid_t getegid(void) { return 0; }
+__attribute__((weak)) pid_t getppid(void) { return 1; }
+__attribute__((weak)) struct passwd *getpwnam(const char *name) { (void)name; return NULL; }
+__attribute__((weak)) void endpwent(void) {}
+__attribute__((weak)) int getrusage(int who, void *usage) {
+    (void)who;
+    if (usage) {
+        unsigned char *p = (unsigned char *)usage;
+        for (size_t i = 0; i < sizeof(struct rusage_stub); ++i) p[i] = 0;
+    }
+    return 0;
+}
+__attribute__((weak)) int chown(const char *path, uid_t owner, gid_t group) {
+    (void)path; (void)owner; (void)group;
+    return 0;
+}
+__attribute__((weak)) mode_t umask(mode_t mask) { (void)mask; return 022; }
+__attribute__((weak)) int pipe(int pipefd[2]) { (void)pipefd; errno = ENOSYS; return -1; }
+__attribute__((weak)) FILE *popen(const char *cmd, const char *type) {
+    (void)cmd; (void)type; errno = ENOSYS; return NULL;
+}
+__attribute__((weak)) int pclose(FILE *stream) { (void)stream; errno = ENOSYS; return -1; }
+__attribute__((weak)) int execl(const char *path, const char *arg, ...) {
+    (void)path; (void)arg; errno = ENOSYS; return -1;
+}
+__attribute__((weak)) int execle(const char *path, const char *arg, ...) {
+    (void)path; (void)arg; errno = ENOSYS; return -1;
+}
+__attribute__((weak)) int execv(const char *path, char *const argv[]) {
+    (void)path; (void)argv; errno = ENOSYS; return -1;
+}
+__attribute__((weak)) long sysconf(int name) {
+#ifdef _SC_PAGESIZE
+    if (name == _SC_PAGESIZE) return 4096;
+#endif
+#ifdef _SC_NPROCESSORS_ONLN
+    if (name == _SC_NPROCESSORS_ONLN) return 4;
+#endif
+    (void)name;
+    return 4096;
+}
+
+#endif
