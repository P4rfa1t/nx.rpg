             case SDL_CONTROLLERBUTTONDOWN:
                 controllerState.buttons[event.cbutton.button] = true;
+#ifdef __SWITCH__
+                if (rtData.config.nxrpg.active) {
+                    auto mapBtn = [](const std::string &name) -> int {
+                        if (name == "A") return SDL_CONTROLLER_BUTTON_B;
+                        if (name == "B") return SDL_CONTROLLER_BUTTON_A;
+                        if (name == "X") return SDL_CONTROLLER_BUTTON_Y;
+                        if (name == "Y") return SDL_CONTROLLER_BUTTON_X;
+                        if (name == "L") return SDL_CONTROLLER_BUTTON_LEFTSHOULDER;
+                        if (name == "R") return SDL_CONTROLLER_BUTTON_RIGHTSHOULDER;
+                        if (name == "PLUS") return SDL_CONTROLLER_BUTTON_START;
+                        if (name == "MINUS") return SDL_CONTROLLER_BUTTON_BACK;
+                        if (name == "LSTICK") return SDL_CONTROLLER_BUTTON_LEFTSTICK;
+                        if (name == "RSTICK") return SDL_CONTROLLER_BUTTON_RIGHTSTICK;
+                        return -1;
+                    };
+                    bool allPressed = !rtData.config.nxrpg.exitCombo.empty();
+                    for (const auto &bname : rtData.config.nxrpg.exitCombo) {
+                        int idx = mapBtn(bname);
+                        if (idx < 0 || !controllerState.buttons[idx]) {
+                            allPressed = false;
+                            break;
+                        }
+                    }
+                    if (allPressed) {
+                        terminate = true;
+                    }
+                }
+#endif
                 break;
                 
             case SDL_CONTROLLERBUTTONUP:
