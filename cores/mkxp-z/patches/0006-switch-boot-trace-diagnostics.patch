+/* ---- nx.rpg boot tracer: append one line per milestone to a fixed boot log.
+ * Lives outside the per-game log so even a crash before conf.read() leaves
+ * an exact death marker on the SD card. ---- */
+static FILE *nxrpg_boot_fp = 0;
+static void nxrpg_boot_open()
+{
+    if (nxrpg_boot_fp) return;
+    nxrpg_boot_fp = fopen("sdmc:/switch/nx.rpg/logs/mkxp-boot.log", "a");
+}
+static void nxrpg_boot(const char *fmt, ...)
+{
+    nxrpg_boot_open();
+    if (!nxrpg_boot_fp) return;
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(nxrpg_boot_fp, fmt, ap);
+    va_end(ap);
+    fputc('\n', nxrpg_boot_fp);
+    fflush(nxrpg_boot_fp);
+    fsync(fileno(nxrpg_boot_fp));
+}
+static const char *nxrpg_sig_name(int sig)
+{
+    switch (sig) {
+    case SIGSEGV: return "SIGSEGV";
+    case SIGABRT: return "SIGABRT";
+    case SIGBUS:  return "SIGBUS";
+    case SIGILL:  return "SIGILL";
+    case SIGFPE:  return "SIGFPE";
+    default:      return "SIG?";
+    }
+}
+static void nxrpg_signal_handler(int sig)
+{
+    /* async-signal-safe-ish best effort write */
+    nxrpg_boot_open();
+    if (nxrpg_boot_fp) {
+        fprintf(nxrpg_boot_fp, "[nx.rpg][FATAL][core=mkxp-z][code=SIG] %d (%s)\n",
+                sig, nxrpg_sig_name(sig));
+        fflush(nxrpg_boot_fp);
+        fsync(fileno(nxrpg_boot_fp));
+        fclose(nxrpg_boot_fp);
+        nxrpg_boot_fp = 0;
+    }
+    _exit(128 + sig);
+}
+static void nxrpg_terminate_handler()
+{
+    if (std::current_exception()) {
+        try { throw; }
+        catch (const Exception &e) {
+            nxrpg_boot("[nx.rpg][FATAL][core=mkxp-z][code=CXX] mkxp Exception: %s", e.msg.c_str());
+        }
+        catch (const std::exception &e) {
+            nxrpg_boot("[nx.rpg][FATAL][core=mkxp-z][code=CXX] std::exception: %s", e.what());
+        }
+        catch (...) {
+            nxrpg_boot("[nx.rpg][FATAL][core=mkxp-z][code=CXX] unknown exception escaped to terminate");
+        }
+    } else {
+        nxrpg_boot("[nx.rpg][FATAL][core=mkxp-z][code=CXX] std::terminate called (no active exception)");
+    }
+    _exit(70);
+}
+static void nxrpg_boot_init()
+{
+    nxrpg_boot_open();
+    if (nxrpg_boot_fp) {
+        signal(SIGSEGV, nxrpg_signal_handler);
+        signal(SIGABRT, nxrpg_signal_handler);
+        signal(SIGBUS, nxrpg_signal_handler);
+        signal(SIGILL, nxrpg_signal_handler);
+        signal(SIGFPE, nxrpg_signal_handler);
+        std::set_terminate(nxrpg_terminate_handler);
+    }
+}
