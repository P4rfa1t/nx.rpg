+RB_METHOD(inputNxSwkbd) {
+    RB_UNUSED_PARAM;
+    VALUE promptV = Qnil;
+    VALUE defaultV = Qnil;
+    VALUE maxLenV = Qnil;
+    rb_scan_args(argc, argv, "03", &promptV, &defaultV, &maxLenV);
+
+    const char *prompt = NIL_P(promptV) ? "" : StringValueCStr(promptV);
+    const char *defText = NIL_P(defaultV) ? "" : StringValueCStr(defaultV);
+    int maxLen = NIL_P(maxLenV) ? 32 : NUM2INT(maxLenV);
+    if (maxLen <= 0 || maxLen > 255) maxLen = 32;
+
+#ifdef __SWITCH__
+    if (!shState->config().nxrpg.enableSoftwareKeyboard) {
+        return rb_utf8_str_new_cstr(defText);
+    }
+    SwkbdConfig kbd;
+    if (R_FAILED(swkbdCreate(&kbd, 0))) {
+        return Qnil;
+    }
+    swkbdConfigMakePresetDefault(&kbd);
+    if (prompt && prompt[0] != '\0') {
+        swkbdConfigSetHeaderText(&kbd, prompt);
+    }
+    if (defText && defText[0] != '\0') {
+        swkbdConfigSetInitialText(&kbd, defText);
+    }
+    swkbdConfigSetStringLenMax(&kbd, static_cast<u32>(maxLen));
+    char outBuf[512] = {};
+    Result rc = swkbdShow(&kbd, outBuf, sizeof(outBuf));
+    swkbdClose(&kbd);
+    if (R_SUCCEEDED(rc)) {
+        return rb_utf8_str_new_cstr(outBuf);
+    }
+    return Qnil;
+#else
+    (void)prompt;
+    (void)maxLen;
+    return rb_utf8_str_new_cstr(defText);
+#endif
+}
