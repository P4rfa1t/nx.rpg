+	size_t FindJsonKeyValuePos(std::string_view json, std::string_view key, size_t search_from = 0) {
+		std::string pat = "\"" + std::string(key) + "\"";
+		size_t pos = json.find(pat, search_from);
+		while (pos != std::string_view::npos) {
+			size_t p = pos + pat.size();
+			while (p < json.size() && std::isspace(static_cast<unsigned char>(json[p]))) ++p;
+			if (p < json.size() && json[p] == ':') {
+				++p;
+				while (p < json.size() && std::isspace(static_cast<unsigned char>(json[p]))) ++p;
+				return p;
+			}
+			pos = json.find(pat, pos + 1);
+		}
+		return std::string_view::npos;
+	}
+
+	std::string ExtractJsonString(std::string_view json, std::string_view key, size_t search_from = 0) {
+		size_t p = FindJsonKeyValuePos(json, key, search_from);
+		if (p == std::string_view::npos || p >= json.size() || json[p] != '"') return "";
+		++p;
+		std::string out;
+		while (p < json.size() && json[p] != '"') {
+			if (json[p] == '\\' && p + 1 < json.size()) {
+				++p;
+				switch (json[p]) {
+					case '"': out.push_back('"'); break;
+					case '\\': out.push_back('\\'); break;
+					case '/': out.push_back('/'); break;
+					case 'n': out.push_back('\n'); break;
+					case 'r': out.push_back('\r'); break;
+					case 't': out.push_back('\t'); break;
+					default: out.push_back(json[p]); break;
+				}
+			} else {
+				out.push_back(json[p]);
+			}
+			++p;
+		}
+		return out;
+	}
+
+	bool ExtractJsonBool(std::string_view json, std::string_view key, bool fallback, size_t search_from = 0) {
+		size_t p = FindJsonKeyValuePos(json, key, search_from);
+		if (p == std::string_view::npos) return fallback;
+		if (json.substr(p, 4) == "true") return true;
+		if (json.substr(p, 5) == "false") return false;
+		return fallback;
+	}
+
+	uint64_t ExtractExitComboMask(std::string_view json) {
+		size_t p = FindJsonKeyValuePos(json, "exitCombo");
+		if (p == std::string_view::npos || p >= json.size() || json[p] != '[') {
+			return HidNpadButton_L | HidNpadButton_R | HidNpadButton_Plus;
+		}
+		size_t end = json.find(']', p);
+		if (end == std::string_view::npos) {
+			return HidNpadButton_L | HidNpadButton_R | HidNpadButton_Plus;
+		}
+		uint64_t mask = 0;
+		std::string_view arr = json.substr(p, end - p + 1);
+		size_t cur = 0;
+		while (cur < arr.size()) {
+			size_t q1 = arr.find('"', cur);
+			if (q1 == std::string_view::npos) break;
+			size_t q2 = arr.find('"', q1 + 1);
+			if (q2 == std::string_view::npos) break;
+			mask |= MapSwitchButton(arr.substr(q1 + 1, q2 - q1 - 1));
+			cur = q2 + 1;
+		}
+		return mask != 0 ? mask : (HidNpadButton_L | HidNpadButton_R | HidNpadButton_Plus);
+	}
+
+	void ApplyCpuProfile(std::string_view profile) {
+		uint32_t hz = 0;
+		if (profile == "boost_1581") {
+			hz = 1581000000u;
+		} else if (profile == "boost_1785") {
+			hz = 1785000000u;
+		} else {
+			return;
+		}
+		if (R_SUCCEEDED(clkrstInitialize())) {
+			if (R_SUCCEEDED(clkrstOpenSession(&nxrpg_clkrst_session, PcvModuleId_CpuBus, 3))) {
+				clkrstSetClockRate(&nxrpg_clkrst_session, hz);
+				nxrpg_clkrst_active = true;
+			} else {
+				clkrstExit();
+			}
+		}
+	}
+
+	bool LoadNxRpgManifest(const std::string& manifest_path, std::vector<std::string>& args) {
+		std::ifstream ifs(manifest_path, std::ios::binary);
+		if (!ifs) return false;
+		std::string json((std::istreambuf_iterator<char>(ifs)), std::istreambuf_iterator<char>());
+		if (json.empty()) return false;
+
+		nxrpg_return_to = ExtractJsonString(json, "returnTo");
+		nxrpg_log_path = ExtractJsonString(json, "logPath");
+		nxrpg_game_id = ExtractJsonString(json, "id");
+		std::string content_root = ExtractJsonString(json, "contentRoot");
+		std::string save_path = ExtractJsonString(json, "savePath");
+		std::string rtp_path = ExtractJsonString(json, "rtpPath");
+		std::string fallback_font = ExtractJsonString(json, "fallbackFontPath");
+		std::string encoding = ExtractJsonString(json, "encoding");
+		std::string cpu_profile = ExtractJsonString(json, "cpuProfile");
+		std::string scaling_mode = ExtractJsonString(json, "scalingMode");
+		std::string soundfont_path = ExtractJsonString(json, "soundfontPath");
+
+		bool disable_rtp = ExtractJsonBool(json, "disableRtp", false);
+		bool vsync = ExtractJsonBool(json, "vsync", true);
+		bool show_fps = ExtractJsonBool(json, "showFps", false);
+		nxrpg_bridge::enable_touch = ExtractJsonBool(json, "enableTouch", true);
+		nxrpg_bridge::swap_confirm_cancel = ExtractJsonBool(json, "swapConfirmCancel", false);
+		nxrpg_bridge::exit_combo_mask = ExtractExitComboMask(json);
+
+		if (!content_root.empty()) {
+			args.push_back("--project-path");
+			args.push_back(content_root);
+		}
+		if (!save_path.empty()) {
+			std::error_code ec;
+			std::filesystem::create_directories(save_path, ec);
+			args.push_back("--save-path");
+			args.push_back(save_path);
+		}
+		std::string mapped_enc = MapEncodingForEasyRpg(encoding);
+		if (!mapped_enc.empty()) {
+			args.push_back("--encoding");
+			args.push_back(mapped_enc);
+		}
+		if (disable_rtp) {
+			args.push_back("--no-rtp");
+		} else if (!rtp_path.empty()) {
+			args.push_back("--rtp-path");
+			args.push_back(rtp_path);
+		}
+		if (!fallback_font.empty() && ::access(fallback_font.c_str(), F_OK) == 0) {
+			args.push_back("--font1");
+			args.push_back(fallback_font);
+		}
+		if (!soundfont_path.empty() && ::access(soundfont_path.c_str(), F_OK) == 0) {
+			args.push_back("--soundfont");
+			args.push_back(soundfont_path);
+		}
+		if (!nxrpg_log_path.empty()) {
+			std::error_code ec;
+			std::filesystem::path lp(nxrpg_log_path);
+			if (lp.has_parent_path()) {
+				std::filesystem::create_directories(lp.parent_path(), ec);
+			}
+			args.push_back("--log-file");
+			args.push_back(nxrpg_log_path);
+		}
+		args.push_back(vsync ? "--vsync" : "--no-vsync");
+		args.push_back(show_fps ? "--show-fps" : "--no-show-fps");
+		args.push_back(scaling_mode == "stretch" ? "--stretch" : "--no-stretch");
+
+		ApplyCpuProfile(cpu_profile);
+		return true;
+	}
