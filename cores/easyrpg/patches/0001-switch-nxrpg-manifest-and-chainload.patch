+		if (name == "PLUS") return HidNpadButton_Plus;
+		if (name == "MINUS") return HidNpadButton_Minus;
+		if (name == "LSTICK") return HidNpadButton_StickL;
+		if (name == "RSTICK") return HidNpadButton_StickR;
+		return 0;
+	}
