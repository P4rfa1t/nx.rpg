+/* nx.rpg: fixed-path boot tracer (open-append-close per line) so crashes
+ * before Output::Init still leave a trail on the SD card. */
+static void nxrpg_eboot(const char* fmt, ...) {
+	FILE* fp = std::fopen("sdmc:/switch/nx.rpg/logs/easyrpg-boot.log", "a");
+	if (!fp) return;
+	va_list ap;
+	va_start(ap, fmt);
+	std::vfprintf(fp, fmt, ap);
+	va_end(ap);
+	std::fputc('\n', fp);
+	std::fflush(fp);
+	fsync(fileno(fp));
+	std::fclose(fp);
+}
+static const char* nxrpg_esig_name(int sig) {
+	switch (sig) {
+	case SIGSEGV: return "SIGSEGV";
+	case SIGABRT: return "SIGABRT";
+	case SIGBUS:  return "SIGBUS";
+	case SIGILL:  return "SIGILL";
+	case SIGFPE:  return "SIGFPE";
+	default:      return "SIG?";
+	}
+}
+static void nxrpg_esignal_handler(int sig) {
+	FILE* fp = std::fopen("sdmc:/switch/nx.rpg/logs/easyrpg-boot.log", "a");
+	if (fp) {
+		std::fprintf(fp, "[nx.rpg][FATAL][core=easyrpg][code=SIG] %d (%s)\n",
+			sig, nxrpg_esig_name(sig));
+		std::fflush(fp);
+		fsync(fileno(fp));
+		std::fclose(fp);
+	}
+	_exit(128 + sig);
+}
+static void nxrpg_eterminate_handler() {
+	if (std::current_exception()) {
+		nxrpg_eboot("[nx.rpg][FATAL][core=easyrpg][code=CXX] exception escaped to std::terminate");
+	} else {
+		nxrpg_eboot("[nx.rpg][FATAL][core=easyrpg][code=CXX] std::terminate called (no active exception)");
+	}
+	_exit(70);
+}
+static void nxrpg_eboot_init() {
+	FILE* fp = std::fopen("sdmc:/switch/nx.rpg/logs/easyrpg-boot.log", "a");
+	if (fp) {
+		std::fclose(fp);
+		signal(SIGSEGV, nxrpg_esignal_handler);
+		signal(SIGABRT, nxrpg_esignal_handler);
+		signal(SIGBUS, nxrpg_esignal_handler);
+		signal(SIGILL, nxrpg_esignal_handler);
+		signal(SIGFPE, nxrpg_esignal_handler);
+		std::set_terminate(nxrpg_eterminate_handler);
+	}
+}
+#endif
