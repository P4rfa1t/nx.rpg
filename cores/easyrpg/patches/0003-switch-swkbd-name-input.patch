 	bool swap_confirm_cancel = false;
 	bool enable_touch = true;
+	bool enable_swkbd = true;
+
+	bool ShowSwitchKeyboard(const std::string& initial, int max_len, std::string& out_text) {
+		if (!enable_swkbd) {
+			return false;
+		}
+		SwkbdConfig kbd;
+		if (R_FAILED(swkbdCreate(&kbd, 0))) {
+			return false;
+		}
+		swkbdConfigMakePresetDefault(&kbd);
+		swkbdConfigSetInitialText(&kbd, initial.c_str());
+		if (max_len > 0) {
+			swkbdConfigSetStringLenMax(&kbd, static_cast<u32>(max_len));
+		}
+		char buf[256] = {};
+		Player::Pause();
+		Result rc = swkbdShow(&kbd, buf, sizeof(buf));
+		Player::Resume();
+		swkbdClose(&kbd);
+		if (R_SUCCEEDED(rc)) {
+			out_text = buf;
+			return true;
+		}
+		return false;
+	}
 }
 
