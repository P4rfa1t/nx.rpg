{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/P4rfa1t/nx.rpg/schemas/upstreams-lock.schema.json",
  "title": "nx.rpg Upstream Cores Lockfile",
  "description": "Pins exact upstream git repositories, branches, commit SHAs, licenses, and local patch queue directories.",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "cores"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "cores": {
      "type": "object",
      "required": ["easyrpg", "nxjs-mvz", "mkxp-z"],
      "properties": {
        "easyrpg": { "$ref": "#/$defs/coreEntry" },
        "nxjs-mvz": { "$ref": "#/$defs/coreEntry" },
        "mkxp-z": { "$ref": "#/$defs/coreEntry" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "coreEntry": {
      "type": "object",
      "required": [
        "name",
        "repoUrl",
        "branch",
        "commit",
        "checkoutDir",
        "patchSeries",
        "license",
        "buildSystem",
        "outputNro"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repoUrl": { "type": "string", "pattern": "^https://github\\.com/.+\\.git$" },
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "checkoutDir": { "type": "string", "minLength": 1 },
        "patchSeries": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "buildSystem": { "type": "string", "enum": ["cmake", "make+pnpm", "meson"] },
        "outputNro": { "type": "string", "pattern": "^cores/.+\\.nro$" },
        "toolchainNotes": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
