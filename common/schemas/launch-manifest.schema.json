{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/P4rfa1t/nx.rpg/schemas/launch-manifest.schema.json",
  "title": "nx.rpg Launch Manifest",
  "description": "Resolved contract written by nx.rpg Launcher to sdmc:/switch/nx.rpg/runtime/launch.json and consumed by EasyRPG, nxjs-mvz, or mkxp-z cores.",
  "type": "object",
  "required": [
    "schemaVersion",
    "sessionId",
    "returnTo",
    "logPath",
    "game",
    "assets",
    "runtime",
    "video",
    "input"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "returnTo": {
      "type": "string",
      "description": "NRO path to invoke with envSetNextLoad when exiting the core."
    },
    "logPath": {
      "type": "string",
      "description": "SD card log file path for core diagnostics and crash summary."
    },
    "game": {
      "type": "object",
      "required": [
        "id",
        "title",
        "engine",
        "core",
        "gamePath",
        "contentRoot",
        "savePath",
        "execName"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]+$"
        },
        "title": {
          "type": "string"
        },
        "engine": {
          "type": "string",
          "enum": ["rm2k", "rm2k3", "rmxp", "rmvx", "rmvxa", "rmmv", "rmmz"]
        },
        "core": {
          "type": "string",
          "enum": ["easyrpg", "nxjs-mvz", "mkxp-z"]
        },
        "gamePath": {
          "type": "string"
        },
        "contentRoot": {
          "type": "string",
          "description": "Actual engine asset root (e.g. <gamePath>/www for desktop RPG Maker MV deployments)."
        },
        "savePath": {
          "type": "string",
          "description": "Isolated per-game writable save directory (sdmc:/switch/nx.rpg/saves/<id>)."
        },
        "execName": {
          "type": "string",
          "default": "Game",
          "description": "Stem name of renamed .ini/.rgssad/.rgss2a/.rgss3a files (default 'Game')."
        }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "required": ["rtpPath", "fallbackFontPath"],
      "properties": {
        "rtpPath": {
          "type": "string",
          "default": ""
        },
        "fallbackFontPath": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "encoding",
        "rgssVersion",
        "cpuProfile",
        "enableTouch",
        "enableSoftwareKeyboard"
      ],
      "properties": {
        "encoding": {
          "type": "string",
          "enum": ["auto", "utf-8", "shift_jis", "gbk", "big5", "cp949", "cp1252"],
          "default": "auto"
        },
        "rgssVersion": {
          "type": "integer",
          "enum": [0, 1, 2, 3],
          "default": 0,
          "description": "Used by mkxp-z: 1=XP, 2=VX, 3=VX Ace, 0=not applicable."
        },
        "cpuProfile": {
          "type": "string",
          "enum": ["stock_1020", "boost_1581", "boost_1785"],
          "default": "stock_1020"
        },
        "enableTouch": {
          "type": "boolean",
          "default": true
        },
        "enableSoftwareKeyboard": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "video": {
      "type": "object",
      "required": ["scalingMode", "integerScale", "vsync", "showFps"],
      "properties": {
        "scalingMode": {
          "type": "string",
          "enum": ["fit", "stretch", "native"],
          "default": "fit"
        },
        "integerScale": {
          "type": "boolean",
          "default": false
        },
        "vsync": {
          "type": "boolean",
          "default": true
        },
        "showFps": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["profile", "swapConfirmCancel", "exitCombo"],
      "properties": {
        "profile": {
          "type": "string",
          "default": "default"
        },
        "swapConfirmCancel": {
          "type": "boolean",
          "default": false
        },
        "exitCombo": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "enum": ["A", "B", "X", "Y", "L", "R", "ZL", "ZR", "PLUS", "MINUS", "LSTICK", "RSTICK"]
          },
          "default": ["L", "R", "PLUS"]
        }
      },
      "additionalProperties": false
    },
    "coreOptions": {
      "type": "object",
      "description": "Engine-family-specific options merged from global defaults and per-game config.",
      "properties": {
        "easyrpg": {
          "type": "object",
          "properties": {
            "soundfontPath": { "type": "string", "default": "" },
            "disableRtp": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        },
        "mvz": {
          "type": "object",
          "properties": {
            "renderer": {
              "type": "string",
              "enum": ["auto", "webgl2", "canvas2d"],
              "default": "auto"
            },
            "pretendNwjs": { "type": "boolean", "default": true },
            "maxTextureSize": { "type": "integer", "enum": [0, 2048, 4096], "default": 4096 }
          },
          "additionalProperties": false
        },
        "mkxp": {
          "type": "object",
          "properties": {
            "enableWin32ApiStubs": { "type": "boolean", "default": true },
            "solidFonts": { "type": "boolean", "default": false },
            "smoothScaling": { "type": "integer", "enum": [0, 1, 2, 3, 4], "default": 0 },
            "frameSkip": { "type": "boolean", "default": false },
            "subImageFix": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
